#!/usr/bin/env bash
# horus-power — energía + ventiladores + GPU (Hybrid, laptop). Horus / NixOS.
#
# MODELO (todo gira en torno al PERFIL, sin comandos por juego):
#   La base es Hybrid. En BATERÍA la dGPU se autosuspende (D3cold, ~0W) cuando nada
#   la usa; en AC NO llega a dormir: queda en idle P8 (~2W). Bajo carga el wataje de
#   la dGPU varía según el perfil (toggle Noctalia). Quién usa la dGPU lo deciden
#   horus-gpu (por app) y horus-gpu-watch (env de sesión por fuente).
#
#   La configuración base es DECLARATIVA en horus-nix; no hay subcomando "setup":
#     • autosuspensión dGPU    -> hardware.nvidia.powerManagement.finegrained
#     • curvas quiet/balanced  -> modules/fan-curves.nix
#     • curva performance      -> horus-gpu-watch (alta en AC, = balanced en batería)
#     • comando de offload     -> nvidia-offload (prime.offload.enableOffloadCmd)
#
#   horus-power silencio      perfil power-saver (dGPU dormida en batería).
#   horus-power equilibrado   perfil balanced.
#   horus-power rendimiento   perfil performance.
#   horus-power gpu-off       apaga la dGPU por firmware (requiere reinicio).
#   horus-power gpu-on        la vuelve a encender (requiere reinicio).
#   horus-power noheat [off]  ventiladores 100% (solo rendimiento + AC).
#   horus-power --actual      estado.
set -uo pipefail
P='\033[0;35m'; G='\033[0;32m'; Y='\033[1;33m'; R='\033[0;31m'; N='\033[0m'
log(){ echo -e "${P}[power]${N} $1"; }; ok(){ echo -e "${G}[+]${N} $1"; }
warn(){ echo -e "${Y}[i]${N} $1"; }; err(){ echo -e "${R}[x]${N} $1"; }

# Solo la curva de emergencia: quiet/balanced son declarativas y performance
# es propiedad de horus-gpu-watch. No reintroducir constantes por perfil aquí.
CURVA_MAX="20c:100%,40c:100%,55c:100%,65c:100%,75c:100%,85c:100%,90c:100%,95c:100%"
DGPU=/sys/devices/platform/asus-nb-wmi/dgpu_disable

_curva(){
    command -v asusctl &>/dev/null || { warn "asusctl no disponible."; return 1; }
    asusctl fan-curve --mod-profile "$1" --fan cpu --data "$2" &>/dev/null
    asusctl fan-curve --mod-profile "$1" --fan gpu --data "$2" &>/dev/null
    asusctl fan-curve --mod-profile "$1" --enable-fan-curves true &>/dev/null
}
_perfil(){
    powerprofilesctl set "$1" 2>/dev/null && ok "Perfil de energía -> $1" \
        || warn "No se pudo fijar $1 (¿power-profiles-daemon?)."
}
_en_ac(){ for p in /sys/class/power_supply/*/online; do
        [ -r "$p" ] && [ "$(cat "$p" 2>/dev/null)" = "1" ] && return 0; done; return 1; }

# ── dGPU por firmware (asus-nb-wmi). Sustituye a supergfxctl del stack Arch ──
_dgpu_set(){ # $1 = 1 apagar | 0 encender
    [ -e "$DGPU" ] || { err "No existe $DGPU."; return 1; }
    local cur; cur=$(cat "$DGPU" 2>/dev/null)
    [ "$cur" = "$1" ] && { ok "La dGPU ya está así (dgpu_disable=$cur)."; return 0; }
    if echo "$1" | sudo tee "$DGPU" >/dev/null 2>&1; then
        ok "dgpu_disable=$1 escrito. REINICIA para que aplique."
    else
        err "El firmware rechazó la escritura (dgpu_disable sigue en $cur)."
        warn "Suele fallar con la dGPU en uso: cierra lo que la ocupe y reintenta."
        return 1
    fi
}

case "${1:-}" in
    silencio|eco|ahorro) _perfil power-saver ;;
    equilibrado|equi|eq) _perfil balanced ;;
    rendimiento|rend|re) _perfil performance ;;
    gpu-off)             _dgpu_set 1 ;;
    gpu-on)              _dgpu_set 0 ;;
    noheat)
        if [ "${2:-on}" = "off" ]; then
            systemctl --user restart horus-gpu-watch 2>/dev/null \
                && ok "Curva de rendimiento restaurada por horus-gpu-watch." \
                || err "No pude reiniciar horus-gpu-watch."
            exit 0
        fi
        prof=$(cat /sys/firmware/acpi/platform_profile 2>/dev/null)
        [ "$prof" = performance ] || { err "noheat solo en rendimiento (estás en '${prof:-?}')."; exit 1; }
        _en_ac || { err "noheat solo con cargador conectado."; exit 1; }
        _curva performance "$CURVA_MAX" && ok "Ventiladores al 100%. Restaura: horus-power noheat off"
        ;;
    --actual|actual)
        # Modo derivado de fuentes nativas (supergfxd era del stack Arch):
        # dgpu_disable=1 o sin NVIDIA enumerada -> Integrated; si no -> Hybrid.
        _dis=$(cat "$DGPU" 2>/dev/null || echo '?')
        if [ "$_dis" = 1 ] || ! ls /proc/driver/nvidia/gpus/ &>/dev/null; then _modo=Integrated
        elif [ "$_dis" = 0 ]; then _modo=Hybrid
        else _modo='?'; fi
        echo "Modo GPU:   $_modo"
        echo "Perfil:     $(cat /sys/firmware/acpi/platform_profile 2>/dev/null || echo '?')"
        if nvidia-smi -q -d POWER &>/dev/null; then
            echo "dGPU:       DESPIERTA ($(nvidia-smi --query-gpu=power.draw --format=csv,noheader 2>/dev/null))"
        else echo "dGPU:       dormida (D3cold)"; fi
        _en_ac && echo "AC:         conectado" || echo "AC:         batería"
        ;;
    *) echo "uso: horus-power [silencio|equilibrado|rendimiento|gpu-off|gpu-on|noheat [off]|--actual]" ;;
esac
